<?xml version="1.0" encoding="UTF-8"?>
<!-- VibeStream Calendar View - Visual calendar-style display -->
<window type="dialog" defaultfocus="3000">
    <controls>
        <!-- Dark background overlay -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF000000">vibestream_common/white.png</texture>
            <animation effect="fade" end="85" time="120">WindowOpen</animation>
        </control>
        
        <!-- Main calendar container -->
        <control type="group">
            <left>60</left>
            <top>40</top>
            <animation effect="fade" end="100" time="200">WindowOpen</animation>
            
            <!-- Header with calendar title -->
            <control type="group">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>45</width>
                    <height>45</height>
                    <align>left</align>
                    <aligny>top</aligny>
                    <aspectratio aligny="top">keep</aspectratio>
                    <texture colordiffuse="FF00D4AA">vibestream_common/vibestream.png</texture>
                </control>
                <control type="label">
                    <left>60</left>
                    <top>5</top>
                    <width>400</width>
                    <height>40</height>
                    <font>font14</font> <!-- VIBESTREAM_33 -->
                    <textcolor>FFCCCCCC</textcolor>
                    <shadowcolor>FF000000</shadowcolor>
                    <align>left</align>
                    <label>[B]TRAKT CALENDAR[/B]</label>
                </control>
            </control>
            
            <!-- Day selector panel (left side) -->
            <control type="group">
                <top>70</top>
                <left>0</left>
                
                <!-- Day selector background -->
                <control type="image">
                    <left>-10</left>
                    <top>-10</top>
                    <width>300</width>
                    <height>930</height>
                    <texture colordiffuse="FF1A1A1A" border="20">vibestream_common/circle.png</texture>
                </control>
                
                <!-- Day list -->
                <control type="fixedlist" id="3000">
                    <left>0</left>
                    <top>0</top>
                    <width>280</width>
                    <height>910</height>
                    <onup>3000</onup>
                    <ondown>3000</ondown>
                    <onright>3001</onright>
                    <orientation>Vertical</orientation>
                    <focusposition>4</focusposition>
                    <movement>4</movement>
                    <scrolltime tween="sine">200</scrolltime>
                    
                    <itemlayout height="100" width="280">
                        <control type="group">
                            <!-- Day container -->
                            <control type="image">
                                <left>5</left>
                                <top>5</top>
                                <width>260</width>
                                <height>90</height>
                                <texture colordiffuse="FF252525" border="15">vibestream_common/circle.png</texture>
                            </control>
                            <!-- Day name -->
                            <control type="label">
                                <left>20</left>
                                <top>15</top>
                                <width>220</width>
                                <height>30</height>
                                <font>font12</font> <!-- VIBESTREAM_26 -->
                                <textcolor>FF888888</textcolor>
                                <align>left</align>
                                <label>$INFO[ListItem.Property(line1)]</label>
                            </control>
                            <!-- Date -->
                            <control type="label">
                                <left>20</left>
                                <top>45</top>
                                <width>150</width>
                                <height>25</height>
                                <font>font10</font> <!-- VIBESTREAM_21 -->
                                <textcolor>FF666666</textcolor>
                                <align>left</align>
                                <label>$INFO[ListItem.Property(line2)]</label>
                            </control>
                            <!-- Episode count -->
                            <control type="label">
                                <left>20</left>
                                <top>65</top>
                                <width>220</width>
                                <height>20</height>
                                <font>font10</font> <!-- VIBESTREAM_21 -->
                                <textcolor>FF555555</textcolor>
                                <align>left</align>
                                <label>$INFO[ListItem.Property(line3)]</label>
                            </control>
                        </control>
                    </itemlayout>
                    
                    <focusedlayout height="100" width="280">
                        <control type="group">
                            <!-- Highlighted day container (darker teal FF008B72 for better contrast) -->
                            <control type="image">
                                <animation effect="fade" start="100" end="85" time="0" condition="!Control.HasFocus(3000)">Conditional</animation>
                                <left>0</left>
                                <top>0</top>
                                <width>270</width>
                                <height>100</height>
                                <texture colordiffuse="FF008B72" border="15">vibestream_common/circle.png</texture>
                            </control>
                            <!-- Day name -->
                            <control type="label">
                                <left>20</left>
                                <top>15</top>
                                <width>220</width>
                                <height>30</height>
                                <font>font13</font> <!-- VIBESTREAM_30 -->
                                <textcolor>FF1A1A1A</textcolor>
                                <align>left</align>
                                <label>[B]$INFO[ListItem.Property(line1)][/B]</label>
                            </control>
                            <!-- Date -->
                            <control type="label">
                                <left>20</left>
                                <top>45</top>
                                <width>150</width>
                                <height>25</height>
                                <font>font12</font> <!-- VIBESTREAM_26 -->
                                <textcolor>FF2A2A2A</textcolor>
                                <align>left</align>
                                <label>$INFO[ListItem.Property(line2)]</label>
                            </control>
                            <!-- Episode count -->
                            <control type="label">
                                <left>20</left>
                                <top>68</top>
                                <width>220</width>
                                <height>20</height>
                                <font>font10</font> <!-- VIBESTREAM_21 -->
                                <textcolor>FF3A3A3A</textcolor>
                                <align>left</align>
                                <label>$INFO[ListItem.Property(line3)]</label>
                            </control>
                        </control>
                    </focusedlayout>
                </control>
            </control>
            
            <!-- Episode panel (right side) -->
            <control type="group">
                <top>70</top>
                <left>320</left>
                
                <!-- Episodes panel background -->
                <control type="image">
                    <left>-10</left>
                    <top>-10</top>
                    <width>1520</width>
                    <height>930</height>
                    <texture colordiffuse="FF151515" border="20">vibestream_common/circle.png</texture>
                </control>
                
                <!-- Episodes header -->
                <control type="label">
                    <left>20</left>
                    <top>10</top>
                    <width>600</width>
                    <height>35</height>
                    <font>font12</font> <!-- VIBESTREAM_26 -->
                    <textcolor>FF888888</textcolor>
                    <align>left</align>
                    <label>[UPPERCASE]EPISODES[/UPPERCASE]</label>
                </control>
                
                <!-- Episode list -->
                <control type="fixedlist" id="3001">
                    <left>10</left>
                    <top>55</top>
                    <width>1480</width>
                    <height>845</height>
                    <onup>3001</onup>
                    <ondown>3001</ondown>
                    <onleft>3000</onleft>
                    <orientation>Vertical</orientation>
                    <focusposition>3</focusposition>
                    <movement>4</movement>
                    <scrolltime tween="sine">200</scrolltime>
                    
                    <itemlayout height="110" width="1480">
                        <control type="group">
                            <!-- Episode card background -->
                            <control type="image">
                                <left>5</left>
                                <top>5</top>
                                <width>1460</width>
                                <height>100</height>
                                <texture colordiffuse="FF202020" border="15">vibestream_common/circle.png</texture>
                            </control>
                            <!-- Episode indicator -->
                            <control type="image">
                                <left>15</left>
                                <top>25</top>
                                <width>8</width>
                                <height>60</height>
                                <texture colordiffuse="FF00D4AA">vibestream_common/white.png</texture>
                            </control>
                            <!-- Show title -->
                            <control type="label">
                                <left>40</left>
                                <top>20</top>
                                <width>1380</width>
                                <height>35</height>
                                <font>font13</font> <!-- VIBESTREAM_30 -->
                                <textcolor>FFCCCCCC</textcolor>
                                <align>left</align>
                                <label>[B]$INFO[ListItem.Property(line1)][/B]</label>
                            </control>
                            <!-- Episode number -->
                            <control type="label">
                                <left>40</left>
                                <top>55</top>
                                <width>1380</width>
                                <height>30</height>
                                <font>font12</font> <!-- VIBESTREAM_26 -->
                                <textcolor>FF777777</textcolor>
                                <align>left</align>
                                <label>$INFO[ListItem.Property(line2)]</label>
                            </control>
                        </control>
                    </itemlayout>
                    
                    <focusedlayout height="110" width="1480">
                        <control type="group">
                            <!-- Highlighted episode card (darker teal for better contrast) -->
                            <control type="image">
                                <animation effect="fade" start="100" end="75" time="0" condition="!Control.HasFocus(3001)">Conditional</animation>
                                <left>0</left>
                                <top>0</top>
                                <width>1470</width>
                                <height>110</height>
                                <texture colordiffuse="FF008B72" border="15">vibestream_common/circle.png</texture>
                            </control>
                            <!-- Show title -->
                            <control type="label">
                                <left>40</left>
                                <top>22</top>
                                <width>1390</width>
                                <height>38</height>
                                <font>font14</font> <!-- VIBESTREAM_33 -->
                                <textcolor>FF1A1A1A</textcolor>
                                <align>left</align>
                                <label>[B]$INFO[ListItem.Property(line1)][/B]</label>
                            </control>
                            <!-- Episode number -->
                            <control type="label">
                                <left>40</left>
                                <top>58</top>
                                <width>1390</width>
                                <height>32</height>
                                <font>font13</font> <!-- VIBESTREAM_30 -->
                                <textcolor>FF2A2A2A</textcolor>
                                <align>left</align>
                                <label>$INFO[ListItem.Property(line2)]</label>
                            </control>
                        </control>
                    </focusedlayout>
                </control>
            </control>
        </control>
    </controls>
</window>
