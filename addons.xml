<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.fenlight" name="VibeStream" provider-name="mritsurgeon" version="1.0.101">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.19.1"/>
        <import addon="script.module.cocoscrapers" version="1.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="resources/lib/fenlight.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="resources/lib/service.py"/>
    <extension point="xbmc.python.module" library="resources/lib/"/>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>true</reuselanguageinvoker>
        <summary lang="en">The ultimate streaming experience for Easynews and Debrid.</summary>
        <description lang="en">VibeStream is a high-performance Kodi addon for streaming from Debrid services and Easynews. Optimized for speed and quality with intelligent auto-fallback.</description>
        <platform>all</platform>
		<disclaimer lang="en">The author of this addon does not host any of the content which is found and has no affiliation with any of the content providers.</disclaimer>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.png</fanart>
        </assets>
        <news>INFO: VibeStream 1.0.101 - Skip initial wizard without addon exit; Trakt PIN flow; dialog labels.</news>
    </extension>
</addon>
<addon id="repository.vibestream" name="VibeStream Repository" version="1.0.0" provider-name="mritsurgeon">
	<extension point="xbmc.addon.repository" name="VibeStream Repository">
		<dir>
			<info compressed="false">https://mritsurgeon.github.io/vibestream/addons.xml</info>
			<checksum>https://mritsurgeon.github.io/vibestream/addons.xml.md5</checksum>
			<datadir zip="true">https://mritsurgeon.github.io/vibestream/packages/</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en">Official VibeStream Repository</summary>
		<description lang="en">Install VibeStream and stay up to date with the latest releases.</description>
		<disclaimer lang="en">Dedicated to high-performance streaming.</disclaimer>
		<platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
	</extension>
</addon>

</addons>